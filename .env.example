# Server
PORT=3000
NODE_ENV=development
JWT_SECRET=your-secret-key

# Database
USE_POSTGRES=false
DATABASE_URL=postgresql://localhost:5432/cybervault

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=cybervault_redis_secret
REDIS_DB=0

# IPFS
IPFS_API_URL=http://localhost:5001

# HIBP
HIBP_ENABLED=true

# Security
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Capability verification (REQUIRED for managed release)
# Base64 of the Plus signer's 32-byte Ed25519 public key.
# Example: PLUS_PUBLIC_KEY=$(openssl rand -base64 32) is NOT a key — use the
# public key Plus publishes at GET /api/v1/crypto/public-key.
# Unset or malformed => every managed release refuses (fail closed).
PLUS_PUBLIC_KEY=

# --- TLS (H6) -----------------------------------------------------------------
# Required in production: NODE_ENV=production refuses to start unless this is
# "true". When it IS true, an unreadable key/cert also refuses to start — the
# server never falls back to plaintext HTTP.
HTTPS_ENABLED=false
TLS_CERT_PATH=./certs/server.crt
TLS_KEY_PATH=./certs/server.key
