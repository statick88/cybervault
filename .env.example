# Server
PORT=3000
NODE_ENV=development
# PLACEHOLDER — replace this value before use (e.g. `openssl rand -base64 48`).
# validateConfig() (src/shared/config.ts) requires JWT_SECRET to be set and at
# least 32 characters in EVERY environment, including development: there is no
# dev bypass, and the server refuses to start otherwise.
JWT_SECRET=CHANGE-ME-PLACEHOLDER-not-a-real-secret-replace-me-0000000000

# Database
USE_POSTGRES=false
DATABASE_URL=postgresql://localhost:5432/cybervault

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=cybervault_redis_secret
REDIS_DB=0

# IPFS
IPFS_API_URL=http://localhost:5001

# HIBP
HIBP_ENABLED=true

# Security
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Production only (NODE_ENV=production): validateConfig() additionally requires
# VAULT_MASTER_KEY, VAULT_ENCRYPTION_SALT, and DB_PASSWORD (unless DATABASE_URL
# starts with sqlite); startup also requires HTTPS_ENABLED=true with readable
# certs (see TLS below). Unset here on purpose: NODE_ENV=development above
# keeps those checks off. Generate unique values per deployment — never ship a
# placeholder as a real secret.

# Capability verification (REQUIRED for managed release)
# Base64 of the Plus signer's 32-byte Ed25519 public key.
# Example: PLUS_PUBLIC_KEY=$(openssl rand -base64 32) is NOT a key — use the
# public key Plus publishes at GET /api/v1/crypto/public-key.
# Unset or malformed => every managed release refuses (fail closed).
PLUS_PUBLIC_KEY=

# --- TLS (H6) -----------------------------------------------------------------
# Required in production: NODE_ENV=production refuses to start unless this is
# "true". When it IS true, an unreadable key/cert also refuses to start — the
# server never falls back to plaintext HTTP.
HTTPS_ENABLED=false
TLS_CERT_PATH=./certs/server.crt
TLS_KEY_PATH=./certs/server.key
# Plus (plus/api/server.ts) enforces the SAME policy with the same three
# variables: with NODE_ENV=production it refuses to boot unless
# HTTPS_ENABLED=true, and HTTPS_ENABLED=true with an unreadable key/cert is
# refused in EVERY environment (development included) — there is no
# "falling back to HTTP" path left. Plus issues capabilities, challenges and
# PIN verifications; none of that may traverse plaintext.
