# Server
PORT=3000
NODE_ENV=development
JWT_SECRET=your-secret-key

# Database
USE_POSTGRES=false
DATABASE_URL=postgresql://localhost:5432/cybervault

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# IPFS
IPFS_API_URL=http://localhost:5001

# HIBP
HIBP_ENABLED=true

# Security
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
