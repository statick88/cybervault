{
  "name": "Real-World Phishing Dataset",
  "description": "26 real-world phishing domains across 5 attack categories from the paper",
  "categories": {
    "brand-impersonation": "Fake brand domains using deceptive naming patterns",
    "subdomain-abuse": "Legitimate brands abused as subdomains of attacker-controlled domains",
    "unicode-cyrillic": "IDN homograph attacks using Cyrillic glyphs visually identical to Latin",
    "typosquatting": "Character substitution and transposition targeting common brands",
    "punycode-idn": "Punycode-encoded IDN domains that render as visual lookalikes"
  },
