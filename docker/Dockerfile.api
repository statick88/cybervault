# Dockerfile para API Vault
# Imagen base minimalista con Node.js para máxima seguridad

FROM node:22-alpine AS builder

# Instalar dependencias de compilación
RUN apk add --no-cache python3 make g++ gcc

# Directorio de trabajo
WORKDIR /app

# Copiar package.json e instalar dependencias
COPY package*.json pnpm-lock.yaml* ./
RUN corepack enable pnpm && pnpm install --ignore-scripts

# Instalar binario de esbuild (necesario para build:ext, postinstall fue ignorado arriba)
RUN node node_modules/esbuild/install.js || true

# Copiar código fuente y scripts de build
COPY tsconfig.json ./

COPY src/ ./src/
COPY scripts/ ./scripts/
COPY tests/ ./tests/
COPY static/ ./static/

# Compilar TypeScript (API server)
RUN npm run build

# Compilar Chrome Extension (IIFE bundles para Service Worker)
RUN npm run build:ext

# Etapa de runtime minimalista
FROM node:22-alpine AS runtime

# Crear usuario no-root para seguridad
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# Directorio de trabajo
WORKDIR /app

# Copiar artefactos compilados
COPY --from=builder --chown=nodejs:nodejs /app/dist ./dist
COPY --from=builder --chown=nodejs:nodejs /app/static ./static
COPY --from=builder --chown=nodejs:nodejs /app/package*.json ./

# Instalar solo dependencias de runtime
RUN corepack enable pnpm && pnpm install --prod --ignore-scripts && \
    pnpm store prune

# Variables de entorno
ENV NODE_ENV=production
ENV PORT=3000

# Exponer puerto
EXPOSE 3000

# Ejecutar como usuario no-root
USER nodejs

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

CMD ["node", "dist/infrastructure/api/server.js"]
