{
  "name": "cyber-vault-mvp",
  "version": "0.1.0",
  "description": "Sistema de gesti\u00f3n de credenciales y monitoreo de vulnerabilidades con Zero-Knowledge y IPFS",
  "type": "commonjs",
  "scripts": {
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "build": "tsc",
    "build:ext": "node scripts/build-extension.mjs",
    "build:all": "npm run build && npm run build:ext",
    "build:docker": "docker build -t cyber-vault/api:latest -f docker/Dockerfile.api .",
    "start": "node dist/src/infrastructure/api/server.js",
    "db:migrate": "npx tsx src/infrastructure/db/cli.ts up",
    "db:migrate:status": "npx tsx src/infrastructure/db/cli.ts status",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:stop": "docker-compose down",
    "docker:clean": "docker-compose down -v --rmi local",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --write src tests",
    "infra:scan": "./infra/scripts/security-scan.sh",
    "security:audit": "./scripts/security-audit.sh",
    "bench": "tsx benchmarks/domain-validation.bench.ts",
    "bench:quick": "tsx benchmarks/domain-validation.bench.ts --iterations 10000 --similarity-iterations 1000",
    "docs": "echo 'API docs at http://localhost:3000/api/docs'"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@noble/post-quantum": "^0.5.4",
    "@types/ioredis": "^4.28.10",
    "@types/pako": "^2.0.4",
    "bech32": "^2.0.0",
    "date-fns": "^4.1.0",
    "express": "^4.19.2",
    "hash-wasm": "^4.12.0",
    "ioredis": "^6.0.0",
    "ipfs-http-client": "^60.0.1",
    "jsonwebtoken": "^9.0.2",
    "libsodium-wrappers": "^0.8.2",
    "pako": "^2.1.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-typescript": "^7.27.1",
    "@playwright/test": "^1.59.1",
    "@types/chrome": "^0.1.37",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "babel-jest": "^29.7.0",
    "esbuild": "^0.27.4",
    "eslint": "^8.0.0",
    "husky": "^9.1.7",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "playwright": "^1.59.1",
    "prettier": "^3.0.0",
    "supertest": "^7.2.2",
    "swagger-ui-dist": "^5.32.14",
    "ts-jest": "^29.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
