{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@plus/*": ["plus/*"]
    }
  },
  "include": ["src/**/*", "plus/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "plus/admin",
    "plus/admin/**"
  ]
}
